#
# Launch the Linux app with Flutter Driver enabled for local MCP interaction.
# Never use this entrypoint for a distributable or clinical build.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! command -v mise >/dev/null 2>&1; then
  echo "mise is required: https://mise.jdx.dev/getting-started.html" >&2
  exit 1
fi

exec mise exec -- flutter run -d linux -t test_driver/driver_main.dart "$@"
