#
# Launch the Flutter-native Linux app for local testing. Passes additional
# arguments to `flutter run`, for example `s/linux --release`.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! command -v mise >/dev/null 2>&1; then
  echo "mise is required: https://mise.jdx.dev/getting-started.html" >&2
  exit 1
fi

exec mise exec -- flutter run -d linux "$@"
