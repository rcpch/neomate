	// Get current time stamp

	function pad(num, size) {
	    var s = "000000000" + num;
	    return s.substr(s.length-size);
	}
	var currentdate = new Date(); 
	var datetime = pad(currentdate.getDate(),2) + "/"
                + pad((currentdate.getMonth()+1),2)  + "/" 
                + currentdate.getFullYear() + " @ "  
